# Resend API key (server-side only, used by the Vercel serverless function).
# Leave blank here; set the real value in Vercel project env settings.
RESEND_API_KEY=

# OPTIONAL server-only shared secret for /api/send-email. Leave blank to rely on
# the same-origin + rate-limit protection (the default for a kiosk). If set, the
# caller must send it as the "x-kiosk-secret" header. Do NOT prefix it with VITE_
# and never ship it to the browser: it is only useful for server-to-server
# callers, not the static kiosk bundle.
SEND_EMAIL_SECRET=

# Sender email for outgoing photo emails. Resend free tier allows onboarding@resend.dev.
VITE_SENDER_EMAIL=onboarding@resend.dev

# Default ADMIN PIN (4 digits) - unlocks the admin panel. Can be changed in the
# admin panel. Keep this private; do not show it to guests.
VITE_DEFAULT_ADMIN_PIN=2802

# Default OPERATOR PIN (4 digits) - confirms the "Sudah Bayar" payment gate.
# This is a SEPARATE secret from the admin PIN (the operator types it in front
# of guests). Can be changed in the admin panel.
VITE_DEFAULT_OPERATOR_PIN=1111

# Default displayed price in IDR. Can be changed in the admin panel.
VITE_DEFAULT_PRICE=25000
